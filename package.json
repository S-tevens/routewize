{
  "name": "routewize",
  "version": "0.1.0",
  "description": "Drop-in proxy that caches semantically similar LLM requests and routes simple requests to cheaper models based on customer-configured rules.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dry-run": "node scripts/dryRun.js",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "js-yaml": "^4.1.0",
    "openai": "^4.73.0",
    "uuid": "^11.0.3"
  }
}
