# Port the proxy listens on
PORT=8787

# Path to the per-customer config file
CUSTOMERS_CONFIG=./src/config/customers.yaml

# Embedding provider used for semantic cache matching: "openai" or "mock"
# "mock" uses a deterministic local embedding (no API calls/cost) — handy for
# dry-run testing without burning real embedding-API money.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# Real customer provider keys referenced via ${ENV_VAR_NAME} in
# customers.yaml (see customers.example.yaml) go here, e.g.:
# DEMO_AGENT_CO_OPENAI_KEY=sk-...
# DEMO_AGENT_CO_ANTHROPIC_KEY=sk-ant-...

# Admin-only, cross-customer overview at /admin (see admin/admin.html).
# A separate secret from any customer's api_key -- never reuse one of
# those here. Unset means the /admin/api/* routes refuse all requests
# (fail closed, not open). Generate one with: openssl rand -hex 32
# ADMIN_TOKEN=

# Optional paid Jev shadow classifier; reference under provider_keys.openrouter.
# DEMO_AGENT_CO_OPENROUTER_KEY=
