# Port the proxy listens on
PORT=8787

# Path to the per-customer config file
CUSTOMERS_CONFIG=./src/config/customers.yaml

# Embedding provider used for semantic cache matching: "openai" or "mock"
# "mock" uses a deterministic local embedding (no API calls/cost) — handy for
# dry-run testing without burning real embedding-API money.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
